# Copy this file to .env and fill in real values. Never commit the real .env file
# (it's already in .gitignore). Config in optionsbot/config/*.yaml is meant to be
# human-edited and committed; secrets and per-machine settings live here instead.

OPTIONSBOT_POLYGON_API_KEY=

OPTIONSBOT_IBKR_HOST=127.0.0.1
OPTIONSBOT_IBKR_PAPER_PORT=7497
OPTIONSBOT_IBKR_LIVE_PORT=7496
OPTIONSBOT_IBKR_CLIENT_ID=7

OPTIONSBOT_LOG_LEVEL=INFO
